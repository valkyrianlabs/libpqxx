# Everything generated (vl-release build_dir release/build, output_dir release/dist, rehearsals):
# downloads, upstream source, compile/stage trees, SDK archives, packages, metadata.
/release/
/build/

# Debian build leftovers (vlr build-deb builds in release/build/deb/src; keep the tree clean if
# someone builds in place)
/debian/.debhelper/
/debian/libpqxx-vh-dev/
/debian/files
/debian/*.substvars
/debian/*.log
/debian/debhelper-build-stamp

# Python
__pycache__/
*.py[cod]

# Local tooling
/.idea/
/.claude/settings.local.json
